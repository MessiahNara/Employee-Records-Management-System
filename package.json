{
  "name": "admin-dashboard-ui",
  "version": "1.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run electron:dev",
    "free-ports": "kill-port 5000 5174",
    "dev": "npm run free-ports && vite --host 0.0.0.0 --port 5174",
    "dev:lan:https": "npm run dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "electron:dev": "npm run free-ports && concurrently \"vite --port 5174\" \"npm run dev --prefix server\" \"wait-on tcp:5174 tcp:5000 && electron .\"",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --target=node18 --outfile=server-bundle/server.bundle.cjs --external:@prisma/client --format=cjs",
    "electron:build": "npm run build && npm run build:server && electron-builder",
    "electron:build:server": "node scripts/build-server.cjs",
    "electron:build:client": "node scripts/build-client.cjs",
    "electron:build:full": "npm run build && npm run build:server && electron-builder --config electron-builder-full.json",
    "electron:build:server-installer": "npm run build && npm run build:server && electron-builder --config electron-builder-server.json",
    "electron:build:client-installer": "npm run build && electron-builder --config electron-builder-client.json"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.23.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "pizzip": "^3.1.7",
    "docxtemplater": "^3.47.3",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-barcode": "^1.6.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "react-router-dom": "^6.22.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/jszip": "^3.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode.react": "^1.0.5",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/xlsx": "^0.0.35",
    "@types/pizzip": "^3.0.5",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jimp": "^1.6.1",
    "kill-port": "^2.0.1",
    "png-to-ico": "^3.0.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.0",
    "vite-plugin-mkcert": "^2.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.hrmdo.emis",
    "productName": "Employee Records Management System",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asarUnpack": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "server-bundle/server.bundle.cjs",
        "to": "server.bundle.cjs"
      },
      {
        "from": "server/node_modules/.prisma",
        "to": "node_modules/.prisma"
      },
      {
        "from": "server/node_modules/@prisma/client",
        "to": "node_modules/@prisma/client"
      },
      {
        "from": "server/.env",
        "to": ".env"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": null,
      "uninstallerSidebar": null,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Employee Records Management System",
      "deleteAppDataOnUninstall": false,
      "include": null,
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033",
      "multiLanguageInstaller": false,
      "packElevateHelper": true,
      "allowElevation": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico",
      "signingHashAlgorithms": null,
      "sign": null,
      "requestedExecutionLevel": "requireAdministrator"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon.png"
    }
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "esbuild@0.21.5": true
  }
}
