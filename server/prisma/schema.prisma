// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id
  username       String   @unique
  password       String
  firstName      String   @default("")
  lastName       String   @default("")
  profilePicture String?  // Profile picture file path (optional)
  role           String   // superadmin, admin, staff
  permissions    Json?    // Store CRUD permissions as JSON for staff users
  lastLogin      DateTime? // Track last login time
  activeSessionId String?  // For single device login verification
  lastActive     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("users")
}

model SystemSetting {
  id                  String   @id @default(uuid())
  idleTimeout         Int?     // Auto logout timeout in minutes (null = disabled)
  appointmentStatuses Json?    // Custom appointment status options
  officeNames         Json?    // Custom office/hospital name options
  positions           Json?    // Custom position/function options
  aoYears             Json?    // Custom series year options
  reasonsForSeparation Json?   // Custom reason for separation options
  autoRename          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("system_settings")
}

model Employee {
  id                  String    @id
  lastName            String
  firstName           String
  middleName          String?
  dateOfBirth         DateTime?
  gender              String
  officeName          String
  appointmentStatus   String
  appointmentFrom     DateTime?
  appointmentTo       DateTime?
  expirationDate      DateTime? // Date of expiration of employment/appointment
  aoNumber            String?   // Administrative Order number
  aoYear              String?   // Series / year of the AO
  status              String    // active/inactive
  position            String
  dateOfEmployment    DateTime?
  dateOfSeparation    DateTime?
  reasonOfSeparation  String?
  isDetailed          Boolean   @default(false)
  aoType              String?   // Detailed | Designated (overrides isDetailed flag)
  motherUnit          String?   // original office when detailed
  detailedTo          String?   // office the employee is detailed to (re-assignment office)
  detailedDivision    String?   // division in the re-assignment office
  detailedFunction    String?   // function/designation in the re-assignment office
  detailedDate        DateTime? // date of re-assignment
  detailedOrderFrom   DateTime? // start date of detailed order
  detailedOrderTo     DateTime? // end date of detailed order
  designatedPositionFunction String?   // position/function when designated
  designatedOrderFrom        DateTime? // start date of designation order
  designatedOrderTo          DateTime? // end date of designation order
  fileboxLocation     String?   // physical filebox location of the 201 file
  file201Status       String?   @default("Available") // Available | Borrowed | Overdue | Lost
  profilePicture      String?   // Profile picture file path (optional)
  yellowBoxId         String?
  yellowBox           YellowBox? @relation(fields: [yellowBoxId], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  documents    Document[]
  borrowLogs   File201BorrowLog[]

  @@map("employees")
}

model Document {
  id          String   @id @default(uuid())
  employeeId  String
  category    String
  fileName    String
  filePath    String   @db.Text
  fileSize    Int      @default(0)
  mimeType    String   @default("application/pdf")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  uploadedBy                  String?   // Name of user who uploaded the document

  // New AO fields
  aoNumber                    String?
  aoYear                      String?
  aoType                      String?
  detailedTo                  String?
  detailedDivision            String?
  detailedFunction            String?
  detailedDate                DateTime?
  detailedOrderFrom           DateTime? // start date of detailed order
  detailedOrderTo             DateTime? // end date of detailed order
  designatedPositionFunction  String?
  designatedOrderFrom         DateTime?
  designatedOrderTo           DateTime?
  appointmentFrom             DateTime?
  appointmentTo               DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String   // create, update, delete, status_change, import
  entity     String   // employee, document, user
  entityId   String
  details    String?  // Store human-readable description here
  metadata   Json?    // Store additional data (e.g., bulk import details)
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model File201BorrowLog {
  id                  String    @id @default(uuid())
  employeeId          String
  action              String    // borrow | return
  borrowerName        String
  borrowerPosition    String?
  borrowerOffice      String?
  purpose             String?
  expectedReturnDate  DateTime?
  dateBorrowed        DateTime  @default(now())
  dateReturned        DateTime?
  fileCondition       String?   // Complete | Incomplete | Damaged
  remarks             String?
  releasedBy          String?   // records officer who released
  returnedByName      String?   // name of person who returned the file
  receivedBy          String?   // records officer who accepted return
  createdAt           DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("file201_borrow_logs")
}

model ApprovalRequest {
  id            String   @id @default(uuid())
  requestedBy   String   // userId of the requester
  requestedByName String  // display name
  action        String   // update_employee | delete_employee | delete_document | bulk_delete
  entityType    String   // employee | document
  entityId      String   // ID of the entity
  entityName    String?  // Human-readable name
  payload       Json     // The full request payload to execute when approved
  status        String   @default("pending") // pending | approved | rejected
  approvedBy    String?  // userId of approver
  approvedByName String?
  rejectedReason String?
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?

  @@map("approval_requests")
}

model Activity {
  id          String   @id @default(uuid())
  title       String
  dateFrom    String   // YYYY-MM-DD
  dateTo      String?  // YYYY-MM-DD
  timeFrom    String?  // HH:MM AM/PM or similar
  timeTo      String?  // HH:MM AM/PM or similar
  location    String
  category    String   // training, holiday, meeting, social, medical
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("activities")
}

model ChatMessage {
  id          String   @id @default(uuid())
  senderId    String
  senderName  String
  recipientId String
  content     String   @db.Text
  read        Boolean  @default(false)
  deletedBySender    Boolean  @default(false)
  deletedByRecipient Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("chat_messages")
}

model YellowBox {
  id         String     @id @default(uuid())
  boxLabel   String     // e.g. "A-D"
  office     String     // e.g. "GSO"
  type       String     // e.g. "R1", "R2", "Non-Regular"
  color      String     @default("#facc15") // e.g. yellow, blue, etc.
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  employees  Employee[]

  @@map("yellow_boxes")
}

