# API Configuration
VITE_API_URL=http://localhost:5000/api
# For LAN clients, either leave VITE_API_URL unset (auto uses current host with :5000)
# or set it explicitly to your host machine IP, e.g.:
# VITE_API_URL=http://192.168.1.50:5000/api
# For HTTPS LAN mobile mode, leave VITE_API_URL unset so the frontend can use the secure same-origin proxy.
